# Stock caddy:2 image has no `cloudflare` ip_source preset, so list
# Cloudflare ranges explicitly (source https://www.cloudflare.com/ips;
# refresh if CF changes). private_ranges covers docker peers/healthchecks.
{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

stepik.study67.fyi {
	tls mjgavrilov@gmail.com

	log {
		output stdout
		format json
	}

	# Edge (Cloudflare orange-cloud -> Caddy -> gate): preserve inbound
	# CF-Connecting-IP from Cloudflare (real client); only set from edge
	# socket when missing (direct origin / healthchecks).
	# trusted_proxies = Cloudflare ranges + docker private_ranges, set in
	# the global block above (plan §5.3).
	# Spoof tradeoff: direct-to-origin can forge CF-Connecting-IP (gate trusts
	# docker-private peer), so lock origin firewall to Cloudflare ranges;
	# ufw: allow 22,80,443 only (80/443 preferably Cloudflare-only).
	request_header -X-Forwarded-For
	@noCF header !CF-Connecting-IP
	request_header @noCF CF-Connecting-IP {http.request.remote.host}

	# Referer needs full path same-origin for Gate cid fallback on /discuss/web/* without ?url=;
	# cross-origin stays origin-only.
	@noEmbed {
		not path /discuss/* /discuss/web/*
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex"
		-Server
	}
	header @noEmbed {
		X-Frame-Options "DENY"
	}

	@static {
		path / /static/* /manifest.json /sw.js /robots.txt /favicon.ico
	}
	handle @static {
		reverse_proxy gate:8081
	}

	handle /healthz {
		# Deep ?deep=1 requires Guard (token + private peer); Caddy injects
		# token so edge deep works (direct without token still 404).
		# Shallow remains public.
		reverse_proxy gate:8081 {
			# CADDY_GATE_TOKEN env required; empty fails closed (Guard false -> 404).
			header_up X-Gate-Auth {env.CADDY_GATE_TOKEN}
		}
	}

	handle /class/* {
		reverse_proxy gate:8081
	}

	handle /auth/* {
		reverse_proxy gate:8081
	}

	# remark42 serves API+web at ROOT (/api/..., /web/...); REMARK_URL path
	# prefix is URL-generation only. handle_path strips /discuss so upstream
	# sees root paths (spike-verified 2026-09-17: prefixed /user->404).
	# forward_auth re-adds the /discuss prefix in X-Forwarded-Uri (below).
	# Public: static embed assets bypass gate auth. iframe.html subrequests
	# (remark.mjs/css) carry Referer=/discuss/web/iframe.html without ?url=,
	# so ExtractCID denies by design; auth is enforced at /api/* instead.
	# Exact paths without trailing slash are redirected to the slash form
	# (3-arg redir; 2-arg adapts to a bogus Location) so prefix strip applies.
	handle /discuss {
		redir /discuss /discuss/ 308
	}

	handle /discuss/web {
		redir /discuss/web /discuss/web/ 308
	}

	handle /discuss/web/* {
		# same-origin iframe for remark42 embed; top-level pages stay DENY via global block.
		header X-Frame-Options "SAMEORIGIN"
		header Content-Security-Policy "frame-ancestors 'self'"
		request_header -X-JWT
		request_header -X-XSRF-TOKEN
		request_header -Remote-User
		request_header -X-Auth-Token
		request_header -X-Auth-User
		uri strip_prefix /discuss
		reverse_proxy remark42:8080
	}

	handle_path /discuss/* {
		# same-origin iframe for remark42 embed; top-level pages stay DENY via global block.
		header X-Frame-Options "SAMEORIGIN"
		header Content-Security-Policy "frame-ancestors 'self'"
		# NOTE: do NOT strip X-JWT/X-XSRF-TOKEN here — copy_headers from
		# forward_auth must survive (see b9eeb29, ops-runbook §8.2). Spoof
		# safe: deny never proxies, allow overwrites via copy_headers.
		request_header -Remote-User
		request_header -X-Auth-Token
		request_header -X-Auth-User
		forward_auth gate:8081 {
			uri /auth/check
			# handle_path already stripped /discuss, so {uri} alone would send
			# "/admin/..." — the gate's teacher-only admin branch matches on the
			# FULL public path "/discuss/admin/...". Re-add the prefix. Must stay
			# in sync with gate/auth ServeHTTP + auth_test fwdFor contract.
			header_up X-Forwarded-Uri /discuss{uri}
			# CADDY_GATE_TOKEN env required; empty fails closed (Guard false -> 404).
			header_up X-Gate-Auth {env.CADDY_GATE_TOKEN}
			copy_headers X-JWT X-XSRF-TOKEN
		}
		reverse_proxy remark42:8080
	}

	handle {
		respond "Not found" 404
	}
}

# Container healthcheck listener: plain HTTP on localhost:8081. The main
# site redirects HTTP->HTTPS (auto_https) and has no cert for "localhost",
# so `wget http://localhost:80/healthz` can never succeed against it. This
# site bypasses the redirect and proxies the gate's shallow /healthz only.
# No ports entry (unpublished). It binds the container's wildcard interface
# (:::8081, not loopback-only) and a docker-network peer can reach it by
# sending Host: localhost:8081 — acceptable: it exposes only the already
# public shallow /healthz; requests with other Hosts get Caddy's default
# empty 200, and deep ?deep=1 still requires X-Gate-Auth (Guard).
http://localhost:8081 {
	handle /healthz {
		reverse_proxy gate:8081
	}
	handle {
		respond 404
	}
}
