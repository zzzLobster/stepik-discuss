# stepik-discuss — deploy/.env.example (KEYS ONLY, no secret values)
# Copy to .env on VPS only. Never commit .env.
#
# Generation:
#   openssl rand -hex 32  # GATE_TOKEN_KEY (32B -> 64 hex), REMARK_JWT_SECRET (64 hex)
#   openssl rand -hex 16  # CADDY_GATE_TOKEN (16B -> 32 hex)

# Stepik OAuth (prod Confidential / Authorization code)
# Boot with placeholder -> /auth/login 503 "Вход временно недоступен. Попробуйте позже.", rest works.
STEPIK_CLIENT_ID=placeholder
STEPIK_CLIENT_SECRET=
STEPIK_REDIRECT_URL=https://stepik.study67.fyi/auth/callback

# Teacher (non-secret default)
TEACHER_ID=1182644732

# Gate session/token encryption (32B from .env only, AES-256-GCM)
GATE_TOKEN_KEY=

# Single JWT secret: .env REMARK_JWT_SECRET maps to BOTH
#   remark42.SECRET=${REMARK_JWT_SECRET} + gate.REMARK_JWT_SECRET (same value)
# Rotation: new .env + up -d both, old dies <=5m (AUTH_TTL_JWT=5m).
REMARK_JWT_SECRET=

# Caddy-only gate token (16B hex), sent as X-Gate-Auth + Docker-subnet guard
CADDY_GATE_TOKEN=

# Web Push VAPID (PWA notifications, plan 0002 §7.1)
# Generation:
#   go run ./gate/cmd/genvapid  # prints VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY (+ VAPID_FP8 for verification only, NOT an env var)
#   openssl rand -hex 32  # PUSH_WEBHOOK_SECRET (32B -> 64 hex)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY_OLD=
VAPID_SUBJECT=mailto:mjgavrilov@gmail.com
PUSH_WEBHOOK_SECRET=

# Verify timings
GATE_VERIFY_TTL=6h
GATE_RETRY_AFTER=15m
GATE_MAX_STALE=48h

# remark42 (non-secret defaults)
SITE=stepik-discuss
REMARK_URL=https://stepik.study67.fyi/discuss
AUTH_ANON=false
ADMIN_SHARED_ID=stepik_1182644732
AUTH_TTL_JWT=5m
AVATAR_PROXY=true
MAX_COMMENT_SIZE=2000
EDIT_TIME=10m
# Placeholder custom provider "stepik" (D0-verified, plan §6.1; NOT secrets —
# dummy values, login via remark42 never completes; identity = Gate JWT only)
AUTH_CUSTOM_NAME=stepik
AUTH_CUSTOM_CID=spike-placeholder-never-completes
AUTH_CUSTOM_CSEC=spike-placeholder-never-completes
AUTH_CUSTOM_AUTH_URL=https://stepik.org/oauth2/authorize/
AUTH_CUSTOM_TOKEN_URL=https://stepik.org/oauth2/token/
AUTH_CUSTOM_INFO_URL=https://stepik.org/api/users/1182644732

# Host bind IP for published 80/443 (no VPS-specific IP in repo per plan §7.2; wildcard default only).
# 0.0.0.0 = all interfaces (single-IP default). Multi-IP VPS: dedicated IP lives in VPS .env only.
CADDY_BIND_IP=0.0.0.0

# remark42 trusted proxy networks (CIDR or IP) for client IP forwarding headers.
# remark42 listens on internal docker network only (behind Caddy forward_auth + Gate JWT).
# Default covers the docker bridge network.
# User-defined docker networks may use 10.0.0.0/8, e.g. TRUSTED_PROXY=172.16.0.0/12,10.0.0.0/8 if needed.
TRUSTED_PROXY=172.16.0.0/12
