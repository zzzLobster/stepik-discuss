# stepik-discuss — deploy/.env.example (KEYS ONLY, no secret values)
# Copy to .env on VPS only. Never commit .env.
#
# Generation:
#   openssl rand -hex 32  # GATE_TOKEN_KEY (32B -> 64 hex), REMARK_JWT_SECRET (64 hex)
#   openssl rand -hex 16  # CADDY_GATE_TOKEN (16B -> 32 hex)

# Stepik OAuth (prod Confidential / Authorization code)
# Boot with placeholder -> /auth/login 503 "Вход временно недоступен. Попробуйте позже.", rest works.
STEPIK_CLIENT_ID=placeholder
STEPIK_CLIENT_SECRET=
STEPIK_REDIRECT_URL=https://stepik.study67.fyi/auth/callback

# Teacher (non-secret default)
TEACHER_ID=1182644732

# Gate session/token encryption (32B from .env only, AES-256-GCM)
GATE_TOKEN_KEY=

# Single JWT secret: .env REMARK_JWT_SECRET maps to BOTH
#   remark42.SECRET=${REMARK_JWT_SECRET} + gate.REMARK_JWT_SECRET (same value)
# Rotation: new .env + up -d both, old dies <=5m (AUTH_TTL_JWT=5m).
REMARK_JWT_SECRET=

# Caddy-only gate token (16B hex), sent as X-Gate-Auth + Docker-subnet guard
CADDY_GATE_TOKEN=

# Verify timings
GATE_VERIFY_TTL=6h
GATE_RETRY_AFTER=15m
GATE_MAX_STALE=48h

# remark42 (non-secret defaults)
SITE=stepik-discuss
REMARK_URL=https://stepik.study67.fyi/discuss
AUTH_ANON=false
ADMIN_SHARED_ID=stepik_1182644732
AUTH_TTL_JWT=5m
AVATAR_PROXY=true
MAX_COMMENT_SIZE=2000
EDIT_TIME=10m
